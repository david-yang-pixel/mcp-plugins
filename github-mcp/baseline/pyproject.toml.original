[project]
name = "tool-services"
version = "0.1.0"
description = "MCP Tool Services for GitHub, official docs, notifications, and sandbox operations."
requires-python = ">=3.9"
dependencies = [
    "fastapi>=0.115",
    "httpx>=0.27",
    "pydantic-settings>=2.0",
    "uvicorn[standard]>=0.30",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
]

[project.scripts]
github-mcp = "tool_services.app:main_github"
docs-tool-service = "tool_services.app:main_docs"
notification-service = "tool_services.app:main_notification"
sandbox-worker = "tool_services.app:main_sandbox"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
