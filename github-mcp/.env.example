# Fill credentials locally; never commit .env.
GITHUB_MCP_HOST=127.0.0.1
GITHUB_MCP_PORT=8111
GITHUB_MCP_API_KEY=
GITHUB_MCP_GITHUB_TOKEN=
GITHUB_MCP_TIMEOUT_SECONDS=30

# Write tools stay hidden and disabled unless ALL of the following are set and the
# write API key differs from GITHUB_MCP_API_KEY.
GITHUB_MCP_WRITE_ENABLED=false
GITHUB_MCP_WRITE_API_KEY=
# Classic PAT with public_repo only (repo only if private repos must be written).
GITHUB_MCP_GITHUB_WRITE_TOKEN=
# Accounts/orgs where repositories, branches, commits and forks may be created.
GITHUB_MCP_WRITE_OWNERS=david-yang-pixel
# Other repos that may receive issues, PRs and comments (comma separated; owner/* allowed).
GITHUB_MCP_UPSTREAM_REPOS=Stardm0/MoonTV
# true: github_create_pr may target ANY repository when head is owner:branch and that
# owner is in GITHUB_MCP_WRITE_OWNERS (a PR from your own fork). Issues and comments
# still need GITHUB_MCP_UPSTREAM_REPOS.
GITHUB_MCP_PR_FROM_OWN_FORK=false
GITHUB_MCP_WRITE_RATE_PER_HOUR=30
