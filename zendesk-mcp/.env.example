# Fill credentials locally; never commit .env.
ZENDESK_MCP_API_KEY=
ZENDESK_MCP_HOST=127.0.0.1
ZENDESK_MCP_PORT=8100
ZENDESK_MCP_WORKERS=1
ZENDESK_MCP_AUDIT_LOG=/opt/zendesk-mcp/logs/audit.jsonl
ZENDESK_MCP_ALLOWED_CUSTOM_FIELD_IDS=
ZENDESK_MCP_REQUEST_TIMEOUT_SECONDS=30
ZENDESK_MCP_CONNECT_TIMEOUT_SECONDS=3
ZENDESK_MCP_READ_TIMEOUT_SECONDS=20
ZENDESK_MCP_MAX_RETRIES=1
ZENDESK_MCP_CACHE_TTL_SECONDS=300
ZENDESK_MCP_CACHE_MAX_ENTRIES=256
ZENDESK_MCP_DOWNLOAD_MAX_BYTES=10485760
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
