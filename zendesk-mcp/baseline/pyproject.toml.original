[project]
name = "zendesk-mcp"
version = "0.1.0"
description = "Remote MCP service for guarded Zendesk ticket lookup and metadata/status updates."
requires-python = ">=3.9"
dependencies = [
    "fastapi>=0.115",
    "requests>=2.31",
    "uvicorn[standard]>=0.30",
]

[project.optional-dependencies]
dev = [
    "httpx>=0.27",
    "pytest>=8.0",
]

[project.scripts]
zendesk-mcp = "zendesk_mcp.app:main"

[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
