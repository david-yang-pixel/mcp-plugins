# Set via a secure environment, not committed credentials.
BINANCE_MCP_API_KEY=
# Optional, both are required for account tools; use a read-only Binance key.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MCP_HOST=127.0.0.1
BINANCE_MCP_PORT=8124
# Optional request body limits (defaults shown)
BINANCE_MCP_MAX_BODY_BYTES=1000000
BINANCE_MCP_MAX_BATCH_SIZE=50

