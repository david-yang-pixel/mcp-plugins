    "HOST_TSH_UID": "0",
    "TELEPORT_PUBLIC_BASE_URL": "https://zendesk.smlershou.top"
  },
  "secrets": {
    "DB_GATEWAY_API_KEY": {
      "name": "MCP_DB_GATEWAY__DB_GATEWAY_API_KEY",
