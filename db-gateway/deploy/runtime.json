    },
    "FEISHU_WEBHOOK_SECRET": {
      "name": "MCP_DB_GATEWAY__FEISHU_WEBHOOK_SECRET",
      "required": false
    },
    "FEISHU_WEBHOOK_URL": {
      "name": "MCP_DB_GATEWAY__FEISHU_WEBHOOK_URL",
      "required": true
    },
    "INTERNAL_SHARED_SECRET": {
      "name": "MCP_DB_GATEWAY__INTERNAL_SHARED_SECRET",
      "required": true
    },
    "PG_PASSWORD": {
      "name": "MCP_DB_GATEWAY__PG_PASSWORD",
      "required": false
    },
    "TELEPORT_PASSWORD": {
      "name": "MCP_DB_GATEWAY__TELEPORT_PASSWORD",
      "required": true
    },
    "TELEPORT_TOTP_SECRET": {
      "name": "MCP_DB_GATEWAY__TELEPORT_TOTP_SECRET",
      "required": true
