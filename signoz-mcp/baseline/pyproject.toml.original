[project]
name = "signoz-mcp"
version = "0.2.0"
description = "Read-only SigNoz MCP with structured diagnostics and a raw sz escape hatch."
requires-python = ">=3.9"
dependencies = [
    "fastapi>=0.115",
    "pydantic-settings>=2.11,<2.14; python_version < '3.10'",
    "pydantic-settings>=2.14.2; python_version >= '3.10'",
    "uvicorn[standard]>=0.30",
]

[project.optional-dependencies]
dev = [
    "httpx>=0.27",
    "pytest>=8.0",
    "pytest-asyncio>=0.23",
]

[project.scripts]
signoz-mcp = "signoz_mcp.app:main"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
