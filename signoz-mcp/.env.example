SIGNOZ_MCP_CHUNK_CONCURRENCY=2
SIGNOZ_MCP_CHUNK_ROW_LIMIT=10000
SIGNOZ_MCP_TOTAL_TIMEOUT_SECONDS=120
SIGNOZ_MCP_TS_BUCKET_PRUNING=true
SIGNOZ_MCP_LOG_MAX_FIELD_CHARS=4000
