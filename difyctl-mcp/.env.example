# Export into the process environment; never commit real values.
MCP_PUBLIC_URL=https://zendesk.smlershou.top/difyctl-mcp
MCP_ALLOWED_EMAILS=
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback http://localhost/callback
DIFYCTL_MCP_API_KEY=
DIFYCTL_MCP_HOST=127.0.0.1
DIFYCTL_MCP_PORT=8000
DIFYCTL_MCP_DATA_DIR=/var/lib/mcp/difyctl
DIFYCTL_BIN=/usr/local/bin/difyctl
DIFYCTL_SKILLS_DIR=/opt/difyctl/skills
DIFY_SERVER=https://cloud.dify.ai
MCP_STATIC_CLIENT_ID=
MCP_STATIC_CLIENT_SECRET=
DIFYCTL_MAX_EFFECT=destructive
DIFYCTL_TIMEOUT_SECONDS=90
DIFYCTL_MAX_TIMEOUT_SECONDS=600
DIFYCTL_MAX_OUTPUT_CHARS=100000
