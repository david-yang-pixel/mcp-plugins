[project]
name = "zendesk-browser-relay"
version = "0.2.0"
description = "HTTP relay that sends Zendesk Agent Workspace messaging replies through a persistent browser session."
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.141.1",
    "playwright==1.60.0",
    "pydantic-settings>=2.14.2",
    "starlette>=1.3.1",
    "uvicorn[standard]>=0.30",
]

[project.optional-dependencies]
dev = [
    "httpx>=0.27",
    "pytest>=8.0",
    "pytest-asyncio>=0.23",
]

[project.scripts]
zendesk-browser-relay = "zendesk_browser_relay.app:main"
zendesk-browser-login = "zendesk_browser_relay.login:main"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
