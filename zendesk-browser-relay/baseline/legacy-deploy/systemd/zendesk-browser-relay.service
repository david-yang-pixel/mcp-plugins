[Unit]
Description=Zendesk Browser Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zendesk-relay
Group=zendesk-relay
WorkingDirectory=/opt/zendesk-browser-relay
EnvironmentFile=/etc/zendesk-browser-relay/env
ExecStart=/opt/zendesk-browser-relay/.venv/bin/uvicorn zendesk_browser_relay.app:app --host 127.0.0.1 --port 8097
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zendesk-browser-relay /var/lib/zendesk-browser-relay

[Install]
WantedBy=multi-user.target

