# Fill credentials locally; never commit .env.
SOURCE_MCP_API_KEY=
SOURCE_MCP_HOST=127.0.0.1
SOURCE_MCP_PORT=8099
SOURCE_MCP_REPOS_BASE_DIR=/opt/zd-agent/resources/saas源代码
SOURCE_MCP_REPOS=dify,dify-billing,dify-marketplace-backend,dify-marketplace-frontend,dify-plugin-daemon,saas-deploy
SOURCE_MCP_FETCH_TTL_SECONDS=900
SOURCE_MCP_SIGNOZ_MCP_URL=https://zendesk.smlershou.top/signoz-mcp/mcp
SOURCE_MCP_SIGNOZ_MCP_API_KEY=
SOURCE_MCP_RUNTIME_DEPLOYMENTS={"dify":"dify-api-oltp","dify-plugin-daemon":"dify-plugindaemon,dify-plugin-daemon","dify-billing":"dify-saas-billing,billing","dify-sandbox":"dify-sandbox","dify-marketplace-backend":"dify-marketplace-backend,dify-marketplace","dify-marketplace":"dify-marketplace-ops-backend,ops-backend","rbac":"rbac,dify-rbac"}
# 路径前缀对应的 deployment（例如 web/ 由 dify-web 运行，版本可能与 API 不同）。
SOURCE_MCP_RUNTIME_PATH_DEPLOYMENTS={"dify":{"web/":"dify-web"}}
SOURCE_MCP_RUNTIME_REF_OVERRIDES={}
SOURCE_MCP_FULL_REPO_SEARCH_CONCURRENCY=1
SOURCE_MCP_PROCESS_ZOMBIE_WARNING_THRESHOLD=10
SOURCE_MCP_PROCESS_PIDS_WARNING_RATIO=0.8
# unshallow/deepen 拉取历史时的超时；普通 git 操作仍用 SOURCE_MCP_GIT_TIMEOUT_SECONDS。
SOURCE_MCP_GIT_HISTORY_TIMEOUT_SECONDS=900
SOURCE_MCP_READ_MAX_FILE_BYTES=20000000
# 需要完整 git 历史的仓库，逗号分隔，* 表示全部。
SOURCE_MCP_FULL_HISTORY_REPOS=*
# 后台定时 fetch 间隔（秒），<=0 关闭。
SOURCE_MCP_BACKGROUND_REFRESH_SECONDS=3600
# 可选：未配置仓库名的提示，JSON：名称 -> 文本或 [{"repo": ..., "paths": [...], "note": ...}]；不设置时使用内置默认值（设为空字符串会关闭提示）。
# SOURCE_MCP_REPO_HINTS=
